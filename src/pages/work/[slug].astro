---
import Base from '../../layouts/Base.astro';
import Pending from '../../components/Pending.astro';
import CaseMedia from '../../components/CaseMedia.astro';
import WorkRow from '../../components/WorkRow.astro';
import VideoPiece from '../../components/VideoPiece.astro';
import LiveEmbed from '../../components/LiveEmbed.astro';
import PrototypeEmbed from '../../components/PrototypeEmbed.astro';
import CaseFigures from '../../components/CaseFigures.astro';
import Spotlight from '../../components/Spotlight.astro';
import WireCompare from '../../components/WireCompare.astro';
import HexText from '../../components/HexText.astro';
import { getProjects, paragraphs, showPending, yearLabel } from '../../lib/projects';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      // Siguiente caso por orden; después del último vuelve al primero.
      next: projects.length > 1 ? projects[(i + 1) % projects.length] : undefined,
    },
  }));
}

const { project, next } = Astro.props;
const d = project.data;

// Título: la palabra `boxed` (o la última) va en la caja azul.
const words = d.title.split(' ');
const boxIndex = d.boxed ? words.findIndex((w) => w.replace(/[^\w]/g, '') === d.boxed) : -1;
const bi = boxIndex >= 0 ? boxIndex : words.length - 1;
const lead = words.slice(0, bi).join(' ');
const boxed = words[bi];
const trail = words.slice(bi + 1).join(' ');

// El título entero se lee en la primera pantalla, sin scroll. El CSS lo limita por el alto (sus líneas
// caben entre el kicker y el borde de abajo) y por el ancho (la línea más larga cabe sin partirse).
// El ancho de cada línea se estima en em por sus caracteres, medido en las dos fuentes con margen:
// Libre Franklin Black en mayúsculas ronda 0.65em por letra y Urbanist Light Italic 0.475em.
const EM_DISPLAY = 0.7;
const EM_SOFT = 0.5;
const titleLines = [
  lead && lead.length * EM_DISPLAY,
  (boxed.length + (trail ? trail.length + 1 : 0)) * EM_DISPLAY + 0.3, // la caja suma su relleno
  d.accent && 0.9 + (d.accent.length + 1) * EM_SOFT, // sangría y punto final
].filter((w): w is number => typeof w === 'number');
// En un teléfono la itálica puede partirse en dos líneas; la palabra más larga no.
const longestWord = Math.max(...d.title.split(' ').map((w) => w.length)) * EM_DISPLAY + 0.3;
const titleFit = `--title-em: ${Math.max(...titleLines).toFixed(2)}; --title-word-em: ${longestWord.toFixed(2)}; --title-lines: ${titleLines.length}`;

const pad = (n: number) => String(n).padStart(2, '0');
const caseNumber = pad(d.order);
const kicker = [`Case ${caseNumber}`, ...d.disciplines, yearLabel(d)].filter((x) => x !== undefined && x !== '');

const summary = paragraphs(d.summary)[0];
const description = summary && !summary.pending ? summary.text : undefined;

// Los datos cortos (y la lista corta de herramientas) van en la columna de la derecha, al lado del
// resumen: así las dos columnas miden parecido. La lista larga de entregables va debajo, en una franja
// de créditos a todo el ancho, como los datos de About. Si el cliente es el mismo título, no se repite.
const meta = [
  d.client && d.client !== d.title && { label: 'Client', value: d.client },
  d.location && { label: 'Location', value: d.location },
  d.role && { label: 'Role', value: d.role },
  d.team && { label: 'Team', value: d.team },
  d.repo && { label: 'Code', value: d.repo.replace(/^https?:\/\/(www\.)?/, ''), href: d.repo },
  d.tools.length > 0 && { label: 'Tools', list: d.tools },
].filter(Boolean) as { label: string; value?: string; list?: string[]; href?: string }[];

// Los entregables van debajo del resumen (al lado de los datos) si así las dos columnas quedan más
// parejas; si no, en la franja a todo el ancho. El alto de cada columna se estima por los caracteres,
// medido en 1440 px: el resumen entra en unos 80 por línea, un dato en 55 y cada una de las dos
// columnas de entregables en 47. Una línea mide unos 28 px.
const LINE = 28;
const lines = (t: string, perLine: number) => Math.max(1, Math.ceil(t.length / perLine));
const summaryH = summary && !summary.pending ? lines(summary.text, 80) * LINE : 0;
const factsH = meta.reduce((h, m, i) => h + 21 + (m.list ? 1 : lines(m.value ?? '', 55)) * LINE + (i ? 24 : 0), 0);
const pairs: string[][] = [];
for (let i = 0; i < d.deliverables.length; i += 2) pairs.push(d.deliverables.slice(i, i + 2));
const besideH = 24 + pairs.reduce((h, p, i) => h + Math.max(...p.map((x) => lines(x, 47))) * LINE + (i ? 16 : 0), 0);
const delivBeside =
  d.deliverables.length > 0 && Math.abs(summaryH + 48 + besideH - factsH) < Math.abs(summaryH - factsH);

// Una selección de video muestra sus piezas en vez de la portada grande: la portada queda para el home.
// La página abre con `opening` si existe: la portada del home es un póster con el título, y aquí ya está el H1.
const pieces = d.pieces;
const showCover = pieces.length === 0;
const coverSrc = d.opening ?? d.cover;

const empty = { text: '', media: [] };
const sections = [
  { key: 'problem', label: 'Problem', ...(d.sections.problem ?? empty) },
  { key: 'role', label: 'My role', ...(d.sections.role ?? empty) },
  { key: 'process', label: 'Process', ...(d.sections.process ?? empty) },
  { key: 'decisions', label: 'Decisions', ...(d.sections.decisions ?? empty) },
  { key: 'result', label: 'Result', ...(d.sections.result ?? empty) },
]
  .map((s) => ({
    ...s,
    paras: paragraphs(s.text),
    media: s.media.filter((m) => m.src || m.screens?.length || showPending),
  }))
  .filter((s) => s.paras.length > 0 || s.media.length > 0);
---

<Base title={d.title} description={description}>
  <article class="case">
    <header class="case-hero wrap" data-case-hero>
      <p class="label kicker" data-case-kicker data-hero-hide>
        <span class="kicker-row">
          {kicker.map((item) => (
            <span class="kicker-item"><span class="sep" aria-hidden="true"></span>{item}</span>
          ))}
        </span>
      </p>

      <h1 class="display title" style={titleFit}>
        {lead && <span class="line lead-line" data-case-lead><span class="line-inner" data-hero-hide>{lead}</span></span>}
        <span class="line"><span class="box" data-case-box data-hero-hide>{boxed}</span>{trail && ` ${trail}`}</span>
        {d.accent && (
          <span class="line accent soft" data-case-accent data-hero-hide>{d.accent}<span class="dot">.</span></span>
        )}
      </h1>

      <div class="grid hero-info" data-case-info data-hero-hide>
        <div class="summary">
          {summary && (summary.pending ? <Pending note={summary.text} /> : <p>{summary.text}</p>)}
          {delivBeside && (<dl class="credits is-beside">
            <div class="credit">
              <dt class="label">Deliverables</dt>
              <dd><ul class="deliverables">{d.deliverables.map((item) => <li>{item}</li>)}</ul></dd>
            </div>
          </dl>)}
        </div>
        {meta.length > 0 && (<dl class="meta">
          {meta.map((m) => (
            <div>
              <dt class="label">{m.label}</dt>
              <dd>
                {m.list ? (
                  <span class="inline-list">
                    <span class="inline-row">
                      {m.list.map((item) => (
                        <span class="inline-item"><span class="sep" aria-hidden="true"></span>{item}</span>
                      ))}
                    </span>
                  </span>
                ) : m.href ? (
                  <a class="meta-link" href={m.href} target="_blank" rel="noopener noreferrer">
                    {m.value} <span aria-hidden="true">→</span>
                  </a>
                ) : (
                  m.value
                )}
              </dd>
            </div>
          ))}
        </dl>)}
        {d.deliverables.length > 0 && !delivBeside && (<dl class="credits">
          <div class="credit">
            <dt class="label">Deliverables</dt>
            <dd><ul class="deliverables">{d.deliverables.map((item) => <li>{item}</li>)}</ul></dd>
          </div>
        </dl>)}
      </div>
    </header>

    {d.compare ? (
      <section class="compare wrap" aria-label="Before and after">
        <div class="compare-pair">
          <figure class="shot" data-surface>
            <img src={d.compare.before} alt={`Global Virtuoso ${d.compare.beforeLabel} manual cover`} loading="lazy" decoding="async" />
            <figcaption class="label shot-label">{d.compare.beforeLabel}</figcaption>
          </figure>
          <span class="compare-arrow" aria-hidden="true">&#8594;</span>
          <figure class="shot" data-surface>
            <img src={d.compare.after} alt={`Global Virtuoso ${d.compare.afterLabel} manual cover`} loading="lazy" decoding="async" />
            <figcaption class="label shot-label">{d.compare.afterLabel}</figcaption>
          </figure>
        </div>
        <p class="compare-note">{d.compare.note}</p>
      </section>
    ) : showCover && (coverSrc || showPending) && (
      <figure class:list={['cover', { pending: !coverSrc }]} data-surface>
        {coverSrc ? (
          <img class:list={[{ bw: !d.coverColor }]} src={coverSrc} alt={description ? `${d.title}: ${description}` : `${d.title} cover`} />
        ) : (
          <div class="cover-slot">
            <span class="label"><span aria-hidden="true">■</span> Pending cover image</span>
          </div>
        )}
      </figure>
    )}

    {d.embed && <LiveEmbed {...d.embed} />}

    {d.prototype && <PrototypeEmbed {...d.prototype} />}

    {d.figures && <CaseFigures {...d.figures} />}

    {pieces.length > 0 && (
      <div class="pieces" data-pieces>
        {pieces.map((piece, i) => (
          <VideoPiece {...piece} index={i} total={pieces.length} />
        ))}
      </div>
    )}

    <div class:list={['case-sections', { 'is-empty': sections.length === 0 }]}>
      {sections.map((s, i) => (<>
        <section class="case-section wrap grid" aria-labelledby={`sec-${s.key}`}>
          <div class="sec-top">
            <header class="sec-head">
              <span class="label sec-num" aria-hidden="true">{pad(i + 1)}</span>
              <h2 class="sec-title" id={`sec-${s.key}`} data-wipe>{s.label}</h2>
            </header>
            {s.paras.length > 0 && (
              <div class:list={['sec-body', 'prose', { leads: s.paras.some((p) => p.lead) }]}>
                {s.paras.map((p) =>
                  p.pending ? (
                    <Pending note={p.text} />
                  ) : p.lead ? (
                    <div class="entry">
                      <h3 class="label lead">{p.lead}</h3>
                      <p><HexText text={p.text} /></p>
                    </div>
                  ) : (
                    <p><HexText text={p.text} /></p>
                  ),
                )}
              </div>
            )}
          </div>
          {s.media.map((m) => (m.screens?.length ? <WireCompare screens={m.screens} caption={m.caption} /> : <CaseMedia {...m} />))}
        </section>
        {d.spotlight?.after === s.key && <Spotlight {...d.spotlight} />}
      </>))}
    </div>

    <nav class="next wrap" aria-label="More work">
      {next ? (
        <>
          <p class="label next-label">Next case</p>
          <WorkRow
            href={`/work/${next.id}/`}
            num={pad(next.data.order)}
            title={next.data.shortTitle ?? next.data.title}
            tags={[...next.data.disciplines, yearLabel(next.data)]}
          />
        </>
      ) : (
        <>
          <p class="label next-label">More work</p>
          <WorkRow href="/#work" title="All work" tags={['Back to the index']} />
        </>
      )}
    </nav>
  </article>
</Base>

<style>
  /* El aire de arriba y el del kicker dependen del alto: en una pantalla baja, el título se queda con
     el espacio. Se usan también en el cálculo del tamaño del título. */
  .case-hero {
    --hero-pad: clamp(2rem, 7svh, 6rem);
    --kicker-gap: clamp(1.5rem, 5svh, 3rem);
    container-type: inline-size;
    padding-top: var(--hero-pad);
    padding-bottom: var(--space-12);
  }

  .kicker {
    margin-bottom: var(--kicker-gap);
    overflow: clip;
  }

  /* Como la fila de estado del hero: cada ítem lleva su separador delante, la fila se corre a la
     izquierda lo que mide un separador y el párrafo la recorta. Si se parte en dos líneas, ninguna
     arranca con un cuadrado suelto. */
  .kicker-row {
    --sep-w: calc(6px + 28px);
    display: flex;
    flex-wrap: wrap;
    row-gap: var(--space-1);
    margin-left: calc(var(--sep-w) * -1);
  }

  .kicker-item {
    white-space: nowrap;
  }

  /* El título entero cabe en la primera pantalla. Gana el menor de tres tamaños:
     el de la escala (--display-xl), el que deja entrar la línea más larga en el ancho (100cqi es el
     ancho de la grilla) y el que deja entrar todas las líneas entre el kicker y el borde de abajo
     (3.5rem del nav, el aire de arriba, el kicker y 2rem de respiro). --title-em y --title-lines
     vienen del frontmatter. */
  .title {
    --fit-w: calc(100cqi / var(--title-em));
    --fit-h: calc(
      (100svh - 3.5rem - var(--hero-pad) - 1rem - var(--kicker-gap) - 2rem) /
        (var(--title-lines) * 0.86 + 0.25)
    );
    font-size: min(var(--display-xl), var(--fit-w), var(--fit-h));
  }

  .title .box {
    margin-block: 0.06em;
  }

  /* La primera línea sube por su máscara al entrar (caseHero.ts) */
  .lead-line {
    overflow: clip;
    padding-bottom: 0.04em;
    margin-bottom: -0.04em;
  }

  .line-inner {
    display: inline-block;
  }

  .accent {
    padding-left: 0.9em;
    color: var(--offwhite);
  }

  .hero-info {
    margin-top: var(--space-12);
    row-gap: var(--space-6);
    align-items: start;
  }

  .summary {
    grid-column: 1 / span 7;
  }

  .summary > p {
    max-width: var(--measure);
  }

  .meta {
    grid-column: 9 / span 4;
    display: grid;
    gap: var(--space-3);
  }

  .meta dt {
    color: var(--text-muted);
    margin-bottom: 0.35em;
  }

  .meta dd {
    margin: 0;
  }

  /* Las herramientas en una línea con ■ naranja, como el kicker: cada una lleva su separador delante,
     la fila se corre lo que mide un separador y se recorta. Si se parte, ninguna línea arranca con ■. */
  .inline-list {
    display: block;
    overflow: clip;
  }

  .inline-row {
    --sep-w: calc(6px + 28px);
    display: flex;
    flex-wrap: wrap;
    margin-left: calc(var(--sep-w) * -1);
  }

  .inline-item {
    white-space: nowrap;
  }

  /* La franja de créditos: el título sobre su valor, a todo el ancho, con los entregables en tres
     columnas (cuatro de la grilla cada una) */
  .credits {
    grid-column: 1 / -1;
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-3);
  }

  .credit dt {
    color: var(--text-muted);
    margin-bottom: 0.6em;
  }

  .credit dd {
    margin: 0;
  }

  .deliverables {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-2) var(--gutter);
  }

  /* Debajo del resumen, en las 7 columnas de la izquierda: dos columnas de entregables */
  .credits.is-beside {
    margin-top: var(--space-6);
  }

  .is-beside .deliverables {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }


  /* Enlace de texto chico: subrayado fino, naranja en hover y la flecha se corre */
  .meta-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    min-height: 44px;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
    transition: color var(--dur-micro) var(--ease-out);
  }

  .meta-link span {
    transition: transform var(--dur-micro) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .meta-link:hover {
      color: var(--orange);
    }

    .meta-link:hover span {
      transform: translateX(4px);
    }
  }

  .cover {
    width: 100%;
  }

  .cover img,
  .cover-slot {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .cover.pending .cover-slot {
    aspect-ratio: 21 / 9;
  }

  .cover-slot {
    display: flex;
    align-items: flex-start;
    padding: var(--margin);
    background: var(--klein);
  }

  .cover-slot .label {
    color: var(--offwhite);
  }

  .compare {
    padding-bottom: 0;
  }

  /* Antes / después: las dos portadas con una flecha naranja en el medio.
     Van a color, no en blanco y negro: son trabajo de diseño, no fotografía. */
  .compare-pair {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--gutter);
  }

  .shot img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
  }

  .shot-label {
    margin-top: var(--space-2);
    color: var(--text-muted);
  }

  /* La flecha va en la columna del medio, centrada con las imágenes. Es el único acento naranja */
  .compare-arrow {
    font-size: clamp(1.75rem, 3.5vw, 3.5rem);
    line-height: 1;
    color: var(--orange);
  }

  .compare-note {
    margin-top: var(--space-6);
    max-width: var(--measure);
    color: var(--text);
  }

  .case-sections {
    padding-bottom: var(--section-pad);
  }

  /* Sin secciones (una selección de video), el aire de abajo lo pone la última pieza */
  .case-sections.is-empty {
    padding-bottom: 0;
  }

  .pieces {
    padding-bottom: var(--section-pad);
  }

  .case-section {
    padding-top: var(--section-pad);
    row-gap: var(--space-6);
  }

  /* El titular ocupa las 5 columnas de la izquierda y el cuerpo las 7 de la derecha:
     antes tomaba las 12 y dejaba muertas las columnas 1 a 5 al lado del texto. */
  /* Titular y texto van juntos en .sec-top, una subgrilla de la sección: el titular pegado (sticky)
     no puede salir de ahí, así no pasa por encima de las imágenes que vienen después del texto. */
  .sec-top {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    row-gap: var(--space-6);
    align-items: start;
  }

  /* El titular acompaña al texto mientras se lee: queda pegado arriba (debajo del nav) hasta que
     termina el cuerpo de su sección. Así la columna de la izquierda no queda vacía a lo largo de un
     texto largo. Solo CSS (sticky), no es un pin de ScrollTrigger. */
  .sec-head {
    grid-column: 1 / span 5;
    align-self: start;
    position: sticky;
    top: var(--travel-top);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .sec-num {
    color: var(--text-muted);
  }

  /* Los titulares de sección van en azul eléctrico: el azul es la voz del sistema y a este tamaño
     pasa el contraste de texto grande sobre negro (3,15:1). Entran con un barrido (wipes.ts). */
  .sec-title {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: var(--display-case);
    line-height: var(--lh-display);
    letter-spacing: var(--track-display);
    text-transform: uppercase;
    color: var(--electric);
  }

  .sec-body {
    grid-column: 6 / span 7;
  }

  /* Una sección que es una lista de puntos (Color, Type, Icons…) se abre con su titular solo y
     debajo una fila por punto: el rótulo en las 5 columnas de la izquierda y su texto en las 7
     de la derecha. Así la columna de la izquierda trabaja en vez de quedar vacía a lo largo. */
  .sec-body.leads {
    display: contents;
  }

  .entry {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    align-items: baseline;
  }

  .entry .lead {
    grid-column: 1 / span 5;
    color: var(--white);
  }

  .entry p {
    grid-column: 6 / span 7;
    margin-top: 0;
  }

  .sec-body > * + * {
    margin-top: 1.1em;
  }

  /* Con rótulos cada fila es su propia fila de la grilla: el aire lo pone el row-gap de la sección */
  .sec-body.leads > * + * {
    margin-top: 0;
  }

  .next {
    padding-bottom: var(--section-pad);
  }

  .next-label {
    color: var(--text-muted);
  }

  @media (max-width: 1100px) {
    .deliverables {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .deliverables,
    .is-beside .deliverables {
      grid-template-columns: minmax(0, 1fr);
    }

    /* En un teléfono hay alto de sobra: la itálica puede partirse en dos líneas. Solo se cuida que
       la palabra más larga quepa en el ancho. */
    .title {
      font-size: min(var(--display-xl), calc(100cqi / var(--title-word-em)));
    }

    .summary,
    .meta,
    .sec-head,
    .sec-body {
      grid-column: 1 / -1;
    }

    /* En una columna el titular va encima de su texto: no hace falta que acompañe */
    .sec-head {
      position: static;
    }

    /* El rótulo pasa a ir encima de su texto */
    .entry .lead,
    .entry p {
      grid-column: 1 / -1;
    }

    .entry .lead {
      margin-bottom: var(--space-2);
    }

    /* Apiladas: una sola columna y la flecha apunta hacia abajo, entre las dos */
    .compare-pair {
      grid-template-columns: minmax(0, 1fr);
    }

    .compare-arrow {
      justify-self: center;
      rotate: 90deg;
    }

    .case-section,
    .sec-top {
      row-gap: var(--space-4);
    }
  }
</style>
