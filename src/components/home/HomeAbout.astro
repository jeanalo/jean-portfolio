---
// About, en tres grupos que se leen en orden:
// 1. Quién soy (7/5, alineado arriba): "ABOUT me.", la bio y debajo la hoja corta (Availability,
//    Languages, Education) en las 7 columnas de la izquierda; el póster de Jean (AboutPoster) en las 5
//    de la derecha. La hoja corta llena el espacio que quedaba bajo la bio: las dos columnas terminan
//    casi a la misma altura sin achicar la foto.
// 2. El kit, a todo el ancho y en pestañas: TOOLS, CODE y AI TOOLS, una lista a la vista por vez, en
//    columnas (en vertical medía unos 700 px y se leía como un footer; Jean, 2026-10-20).
// Móvil: titular, póster, bio, hoja corta y el kit en una columna.
import AboutPoster from './AboutPoster.astro';

const bio = [
  'I love audiovisual media and communication: editing, motion, and the moment a message finally clicks. That eye for story and rhythm runs through everything I make.',
  'My core is interactive media design: UX and web, digital products that start with deep research, grow user-centered, and get tested until they feel obvious. If it looks great but is hard to use, it isn’t finished.',
  'I use AI every day, and teach teams to use it well: it helps me move faster and explore further, but the final call is always mine as a designer.',
];

// Lo que más se pregunta primero (¿está disponible?, ¿podemos hablar?) va arriba, con la bio.
const who = [
  { key: 'availability', label: 'Availability', text: 'Open to freelance projects now.' },
  { key: 'languages', label: 'Languages', list: ['Spanish (native)', 'English (C1)'], inline: true },
  { key: 'education', label: 'Education', text: "Bachelor's in Interactive Media Design, Universidad Icesi, Cali. In progress." },
];

// El kit: cada lista en vertical, una herramienta por línea. Podado por Jean el 2026-10-19.
// AI tools va agrupada por categoría, en dos columnas (una sola se hacía demasiado larga).
// Cuántas herramientas tiene cada pestaña
const count = (k: { list?: string[]; groups?: { items: string[] }[] }) =>
  k.list?.length ?? k.groups?.reduce((n, g) => n + g.items.length, 0) ?? 0;

const kits = [
  { key: 'tools', label: 'Tools', list: ['Premiere Pro', 'After Effects', 'DaVinci Resolve', 'CapCut', 'Figma', 'Illustrator', 'Photoshop', 'Lightroom', 'InDesign', 'Audition', 'Blender', 'Canva', 'Framer'] },
  { key: 'code', label: 'Code', list: ['React', 'Astro', 'JavaScript', 'TypeScript', 'HTML', 'CSS', 'Tailwind CSS', 'Node.js', 'Firebase', 'Git', 'Arduino (C++)'] },
  {
    key: 'ai',
    label: 'AI tools',
    groups: [
      { title: 'Assistants & agents', items: ['Claude', 'Claude Code', 'Claude Agents', 'ChatGPT', 'Gemini', 'NotebookLM'] },
      { title: 'Video', items: ['Veo', 'Sora', 'Runway', 'Kling', 'Google Flow', 'Hedra'] },
      { title: 'Image', items: ['Midjourney', 'Firefly'] },
      { title: 'Audio', items: ['ElevenLabs', 'Suno'] },
    ],
  },
];
---

<section id="about" class="about wrap grid" aria-labelledby="about-title">
  <h2 id="about-title" class="display title" data-reveal-title>About <span class="soft">me<span class="dot">.</span></span></h2>

  <div class="photo">
    <AboutPoster />
  </div>

  <div class="bio" data-reveal-text>
    {bio.map((p) => <p>{p}</p>)}
  </div>

  <dl class="who" data-reveal-text>
    {who.map((f) => (
      <div class:list={['fact', `fact-${f.key}`]}>
        <dt class="fact-title">{f.label}</dt>
        <dd class="fact-value">
          {f.text && <p>{f.text}</p>}
          {f.list && (
            <ul class="inline-list">
              {f.list.map((t) => (
                <li><span class="sep" aria-hidden="true"></span>{t}</li>
              ))}
            </ul>
          )}
        </dd>
      </div>
    ))}
  </dl>

  <!-- El kit en pestañas: TOOLS, CODE y AI TOOLS, con cuántas herramientas tiene cada una. Una lista a la
       vista por vez, en columnas; la pestaña activa va en la caja azul de la casa. Radios nativos: funciona
       sin JS y con las flechas, como el Then / Now de Off the clock. -->
  <div class="kits" data-reveal-text>
    <fieldset class="kit-tabs">
      <legend class="sr-only">The kit</legend>
      {kits.map((k, i) => (
        <label class="kit-tab">
          <input type="radio" name="kit" value={k.key} checked={i === 0} />
          <span class="kit-name">{k.label}</span>
          <span class="kit-count">{count(k)}</span>
        </label>
      ))}
    </fieldset>

    <div class="kit-panels">
      {kits.map((k) => (
        <div class:list={['kit-panel', `kit-${k.key}`]}>
          {k.list && (
            <ul class="kit-list">
              {k.list.map((t) => <li>{t}</li>)}
            </ul>
          )}
          {k.groups && (
            <div class="kit-groups">
              {k.groups.map((g) => (
                <div class="group">
                  <span class="label group-title">{g.title}</span>
                  <ul>
                    {g.items.map((t) => <li>{t}</li>)}
                  </ul>
                </div>
              ))}
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* Quién soy a la izquierda (titular, bio, hoja corta), el póster a la derecha, y el kit a todo el
     ancho debajo. Tres tamaños en la sección: el titular, --display-xs (títulos de datos) y el cuerpo. */
  .about {
    grid-template-areas:
      'title title title title title title title photo photo photo photo photo'
      'bio   bio   bio   bio   bio   bio   .     photo photo photo photo photo'
      'who   who   who   who   who   who   .     photo photo photo photo photo'
      'kits  kits  kits  kits  kits  kits  kits  kits  kits  kits  kits  kits';
    grid-template-rows: auto auto 1fr auto;
    align-items: start;
    padding-block: var(--section-pad);
  }

  .title {
    grid-area: title;
    font-size: var(--display-l);
  }

  /* La bio en un solo peso, pegada al titular, al tamaño del cuerpo como el resto de la página */
  .bio {
    grid-area: bio;
    margin-top: var(--space-6);
  }

  .bio p {
    max-width: var(--measure);
    font-size: var(--body);
    line-height: var(--lh-body);
    color: var(--white);
    text-wrap: pretty;
  }

  .bio p + p {
    margin-top: 1em;
  }

  /* La hoja corta llena el espacio bajo la bio: Availability y Languages lado a lado, Education a lo
     ancho de las dos */
  .who {
    grid-area: who;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6) var(--gutter);
    margin: var(--space-8) 0 0;
  }

  .fact-education {
    grid-column: 1 / -1;
  }

  /* El kit en pestañas: una franja a todo el ancho que mide lo que el panel activo. Antes eran tres
     listas en vertical de hasta 13 renglones: unos 700 px que se leían como el mapa de un footer. (Si los
     paneles reservaran el alto del más largo, sobraría aire al pie de About y el hueco hasta Off the
     clock pasaría el límite.) */
  .kits {
    grid-area: kits;
    margin-top: var(--space-12);
  }

  .kit-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    margin: 0;
    padding: 0;
    border: 0;
  }

  .kit-tab {
    position: relative;
    display: inline-flex;
    align-items: flex-start;
    gap: 0.4em;
    min-height: 44px;
    cursor: pointer;
    color: var(--text-muted);
    transition: color var(--dur-micro) var(--ease-out);
  }

  .kit-tab input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .kit-name {
    padding: 0.04em 0.14em 0.02em;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: var(--display-xs);
    line-height: var(--lh-display);
    letter-spacing: -0.03em;
    text-transform: uppercase;
    transform-origin: left center;
    transition: transform var(--dur-micro) var(--ease-out);
  }

  .kit-count {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--label);
    letter-spacing: var(--track-label);
  }

  /* La pestaña activa: la caja azul de la casa, a -2°, con el texto blanco */
  .kit-tab:has(input:checked) {
    color: var(--white);
  }

  .kit-tab:has(input:checked) .kit-name {
    background: var(--electric);
    transform: rotate(var(--tilt));
  }

  .kit-tab:has(input:focus-visible) {
    outline: 2px solid var(--electric);
    outline-offset: 6px;
  }

  @media (hover: hover) and (pointer: fine) {
    .kit-tab:not(:has(input:checked)):hover {
      color: var(--electric);
    }
  }

  .kit-panels {
    margin-top: var(--space-4);
  }

  .kit-panel {
    display: none;
  }

  .kits:has(input[value="tools"]:checked) .kit-tools,
  .kits:has(input[value="code"]:checked) .kit-code,
  .kits:has(input[value="ai"]:checked) .kit-ai {
    display: block;
  }

  /* El panel que aparece entra con un fundido corto y sube 8 px (solo opacity y transform) */
  @media (prefers-reduced-motion: no-preference) {
    .kits:has(input[value="tools"]:checked) .kit-tools,
    .kits:has(input[value="code"]:checked) .kit-code,
    .kits:has(input[value="ai"]:checked) .kit-ai {
      animation: kit-in 220ms var(--ease-out);
    }
  }

  @keyframes kit-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  /* Cada lista en 4 columnas, que se leen de arriba abajo */
  .kit-list {
    columns: 4;
    column-gap: var(--gutter);
  }

  .kit-list li,
  .kit-groups li {
    padding-block: 0.12em;
    break-inside: avoid;
  }

  /* AI tools por categoría: una columna por categoría */
  .kit-groups {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-4) var(--gutter);
  }

  .group-title {
    display: block;
    margin-bottom: var(--space-1);
    color: var(--text-muted);
  }

  .fact-title {
    margin-bottom: var(--space-2);
    font-family: var(--font-display);
    font-weight: 900;
    font-size: var(--display-xs);
    line-height: var(--lh-display);
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: var(--white);
  }

  .fact-value {
    margin: 0;
    color: var(--text);
  }

  .fact-value p {
    max-width: 44ch;
    text-wrap: pretty;
  }

  /* Listas en línea (Languages): cada ítem con su cuadrado delante y el primero recortado */
  .inline-list {
    display: flex;
    flex-wrap: wrap;
    margin-left: -34px; /* ancho de .sep (6px) más sus márgenes (14px a cada lado) */
    clip-path: inset(0 0 0 34px);
  }

  .inline-list li {
    white-space: nowrap;
  }

  /* El póster: ancho limitado también por el alto, para verse entero desde 1280 × 529.
     Cuando el alto lo achica, se alinea al borde derecho de la grilla. */
  .photo {
    grid-area: photo;
    justify-self: end;
    width: min(100%, 92svh);
    margin: 0;
  }

  /* Escritorio chico: el kit pasa a filas de hoja de rodaje, con el título en las columnas 1 a 4 y la
     lista en dos columnas en la 5 a 12 */
  @media (min-width: 761px) and (max-width: 1100px) {
    /* En tablet la hoja corta baja a todo el ancho: al lado del póster solo quedan el titular y la
       bio, que miden casi lo mismo que él, sin hueco */
    .about {
      grid-template-areas:
        'title title title title title title title photo photo photo photo photo'
        'bio   bio   bio   bio   bio   bio   .     photo photo photo photo photo'
        'who   who   who   who   who   who   who   who   who   who   who   who'
        'kits  kits  kits  kits  kits  kits  kits  kits  kits  kits  kits  kits';
      grid-template-rows: auto 1fr auto auto;
    }

    .who {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-4) var(--gutter);
      margin-top: var(--space-8);
    }

    .fact-education {
      grid-column: auto;
    }

    .kit-list {
      columns: 3;
    }
  }

  @media (max-width: 760px) {
    .about {
      grid-template-areas:
        'title'
        'photo'
        'bio'
        'who'
        'kits';
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
    }

    .photo {
      width: 100%;
      margin-top: var(--space-4);
    }

    .who {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-4);
      margin-top: var(--space-8);
    }

    .fact-education {
      grid-column: 1;
    }

    .kits {
      margin-top: var(--space-8);
    }

    .kit-tabs {
      column-gap: var(--space-4);
    }

    /* En el teléfono, de a dos columnas */
    .kit-list {
      columns: 2;
    }

    .kit-groups {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
