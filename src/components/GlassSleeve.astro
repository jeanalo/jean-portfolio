---
// Funda plástica de vidrio. La escarapela y la foto de About comparten este mismo material:
// un poco más grande que lo que guarda (el aire lo da --sleeve-pad), borde de luz, brillo especular
// y refracción solo en el anillo del borde (filtro SVG en Chromium; blur leve en el resto).
// El brillo es un elemento propio (data-sleeve-shine) para poder deslizarlo con transform.
// Las clases y los atributos que llegan (data-badge-card, data-surface...) van al contenedor.
const { class: className, ...attrs } = Astro.props;
---

<div class:list={['glass-sleeve', className]} {...attrs}>
  <slot />
  <span class="glass-sleeve-edge" aria-hidden="true"></span>
  <span class="glass-sleeve-glass" aria-hidden="true"><span class="glass-sleeve-shine" data-sleeve-shine></span></span>
</div>

<style>
  .glass-sleeve {
    position: relative;
    padding: var(--sleeve-pad);
  }

  /* Vidrio de la funda: tinte casi nulo, borde de luz y brillo especular */
  .glass-sleeve-glass {
    position: absolute;
    z-index: 2;
    inset: 0;
    overflow: hidden; /* el brillo se desliza sin salirse de la funda */
    pointer-events: none;
    background: rgb(255 255 255 / 0.05);
    border: 1px solid rgb(255 255 255 / 0.5);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.7),
      inset 0 0 0 1px rgb(255 255 255 / 0.08),
      inset 0 0 22px rgb(255 255 255 / 0.12);
  }

  .glass-sleeve-shine {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      118deg,
      rgb(255 255 255 / 0) 34%,
      rgb(255 255 255 / 0.32) 44%,
      rgb(255 255 255 / 0.06) 50%,
      rgb(255 255 255 / 0) 58%
    );
  }

  /* Anillo del borde: blur leve en todos; refracción SVG en Chromium */
  .glass-sleeve-edge {
    position: absolute;
    inset: 0;
    pointer-events: none;
    padding: var(--sleeve-pad);
    -webkit-backdrop-filter: blur(1.5px) saturate(140%);
    backdrop-filter: blur(1.5px) saturate(140%);
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#000 0 0) content-box exclude,
      linear-gradient(#000 0 0);
  }

  :global(.refract) .glass-sleeve-edge {
    backdrop-filter: url(#glass-refract-fine) blur(0.5px) saturate(140%);
  }

  @media (prefers-reduced-transparency: reduce) {
    .glass-sleeve-edge {
      display: none;
    }
  }
</style>
