---
// La pieza que diferencia un caso, con peso propio (en Mentta, el sensor físico).
// Un campo Klein a todo el ancho, como What I do: la página va negro, azul, negro.
// Titular en las 5 columnas de la izquierda y el texto en las 7 de la derecha, como las secciones del
// caso; debajo, las fotos en blanco y negro (fotografía) en rectángulos duros, y el recorrido de los
// datos paso a paso, separado por flechas. Sobre Klein, todo el texto va en blanco.
// Motion (src/scripts/motion/spotlight.ts): las fotos entran en orden y los pasos se encienden de
// izquierda a derecha, como los datos que viajan del sensor a la app.
import { paragraphs } from '../lib/projects';
import { imageSize } from '../lib/imageSize';

interface Props {
  title: string;
  text: string;
  steps: string[];
  detail?: { src: string; alt: string; caption?: string; color?: boolean };
  photos: { src: string; alt: string }[];
  caption?: string;
}
const { title, text, steps, detail, photos, caption } = Astro.props;
const paras = paragraphs(text);
const pad = (n: number) => String(n).padStart(2, '0');
const detailDim = detail ? imageSize(detail.src) : undefined;
---

<section class="spotlight" aria-labelledby="spotlight-title" data-spotlight>
  <div class="wrap grid inner">
    <div class="spread">
      <div class:list={['head', { 'is-side': detail }]}>
        <h2 id="spotlight-title" class="title" data-wipe>{title}</h2>
        <div class="body" data-reveal-text>
          {paras.map((p) => <p>{p.text}</p>)}
        </div>

        {detail && steps.length > 0 && (
          <ol class="flow is-stacked" aria-label="Data flow">
            {steps.map((s, i) => (
              <li class="step" data-spotlight-step>
                <span class="label n">{pad(i + 1)}</span>
                <span class="what">{s}</span>
              </li>
            ))}
          </ol>
        )}
      </div>

      {detail && (
        <figure class="detail">
          <img
            class:list={['detail-img', detail.color ? 'whole' : 'bw']}
            src={detail.src}
            alt={detail.alt}
            width={detailDim?.width}
            height={detailDim?.height}
            style={detail.color && detailDim ? `--ar: ${detailDim.width} / ${detailDim.height}` : undefined}
            loading="lazy"
            decoding="async"
            data-spotlight-photo
          />
          {detail.caption && <figcaption class="caption">{detail.caption}</figcaption>}
        </figure>
      )}
    </div>

    {photos.length > 0 && (
      <figure class="photos">
        <div class="grid shots">
          {photos.map((ph) => {
            const dim = imageSize(ph.src);
            return (
              <img
                class="shot bw"
                src={ph.src}
                alt={ph.alt}
                width={dim?.width}
                height={dim?.height}
                loading="lazy"
                decoding="async"
                data-spotlight-photo
              />
            );
          })}
        </div>
        {caption && <figcaption class="caption">{caption}</figcaption>}
      </figure>
    )}

    {!detail && steps.length > 0 && (
      <ol class="flow" aria-label="Data flow" style={`--steps: ${steps.length}`}>
        {steps.map((s, i) => (
          <li class="step" data-spotlight-step>
            <span class="label n">{pad(i + 1)}</span>
            <span class="what">{s}</span>
            {i < steps.length - 1 && <span class="arrow" aria-hidden="true">→</span>}
          </li>
        ))}
      </ol>
    )}
  </div>
</section>

<style>
  .spotlight {
    margin-top: var(--section-pad);
    padding-block: var(--section-pad);
    background: var(--klein);
    color: var(--white);
  }

  .inner {
    row-gap: var(--space-6);
    align-items: start;
  }

  /* Sin primer plano: titular en las columnas 1 a 5 y texto en la 6 a 12, como las secciones.
     Con primer plano (detail): la imagen en las 7 de la izquierda y al lado, en las 5 de la derecha,
     el titular, el texto y el recorrido en columna, alineados arriba con la imagen. Así la columna de
     al lado trabaja en vez de quedar vacía junto a una foto alta. */
  /* Titular, texto e imagen van juntos en .spread: la imagen pegada (sticky) no puede salir de ahí,
     así no baja por encima de las fotos que vienen después */
  .spread {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    row-gap: var(--space-6);
    align-items: start;
  }

  .head {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    row-gap: var(--space-6);
    align-items: start;
  }

  .head.is-side {
    grid-column: 8 / span 5;
    grid-row: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .title {
    grid-column: 1 / span 5;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: var(--display-case);
    line-height: var(--lh-display);
    letter-spacing: var(--track-display);
    text-transform: uppercase;
    color: var(--white);
  }

  .body {
    grid-column: 6 / span 7;
    max-width: var(--measure);
  }

  .body p {
    color: var(--white);
  }

  .body p + p {
    margin-top: 1.1em;
  }

  /* El primer plano del objeto en su lugar, grande, y al lado el recorrido de los datos en columna:
     primero la cosa, después lo que hace */
  .detail {
    grid-column: 1 / span 7;
    grid-row: 1;
  }

  /* La imagen acompaña a la columna de texto si esta es más larga (lo mismo que los titulares de las
     secciones del caso) */
  @media (min-width: 761px) {
    .detail {
      position: sticky;
      top: var(--travel-top);
      align-self: start;
    }
  }

  .detail-img {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }

  /* Una pantalla de interfaz va entera, con su proporción real (leída del archivo al generar el sitio) */
  .detail-img.whole {
    aspect-ratio: var(--ar, 16 / 10);
    object-fit: fill;
  }

  .flow.is-stacked {
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-2);
    margin-top: var(--space-2);
  }

  .flow.is-stacked .step {
    flex-direction: row;
    align-items: baseline;
    gap: var(--space-2);
    padding-right: 0;
  }

  .photos {
    grid-column: 1 / -1;
  }

  .shots {
    row-gap: var(--gutter);
  }

  .shot {
    grid-column: span 3;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }

  .caption {
    margin-top: var(--space-2);
    font-size: var(--label);
    line-height: 1.5;
    color: var(--white);
  }

  /* El recorrido de los datos: cinco pasos en fila, separados por flechas blancas */
  .flow {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(var(--steps, 5), minmax(0, 1fr));
    gap: var(--gutter);
    counter-reset: step;
  }

  .step {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-right: var(--space-4);
  }

  .n {
    flex: none;
    min-width: 2.4em;
    font-variant-numeric: tabular-nums;
    color: var(--white);
  }

  .what {
    color: var(--white);
  }

  .arrow {
    position: absolute;
    top: 0;
    right: 0;
    font-size: var(--body);
    line-height: 1.2;
    color: var(--white);
  }

  @media (max-width: 1100px) {
    .shot {
      grid-column: span 6;
    }

    .flow {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-3);
    }

    .step {
      flex-direction: row;
      align-items: baseline;
      gap: var(--space-2);
      padding-right: 0;
    }

    /* En columna los números ya dan el orden: la flecha sobra */
    .arrow {
      display: none;
    }
  }

  @media (max-width: 760px) {
    .title,
    .body,
    .detail,
    .head.is-side,
    .flow.is-stacked {
      grid-column: 1 / -1;
    }

    /* En una columna: titular, texto, recorrido y después la imagen */
    .head.is-side,
    .detail {
      grid-row: auto;
    }
  }
</style>
